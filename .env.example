# Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# DO NOT commit actual private keys or secrets to version control.

# Simulation Environment Settings
SIM_ENVIRONMENT=local_simulation
SIM_RANDOM_SEED=42
SIM_AGENT_POPULATION=30
SIM_DEFAULT_ROUNDS=100
SIM_LOG_LEVEL=INFO

# Vector & Evidence Store (RAG)
VECTOR_STORE_BACKEND=in_memory
EMBEDDING_MODEL_DIMENSION=384
EVIDENCE_RECENCY_HALF_LIFE_DAYS=30

# Blockchain Anchor Configuration (Simulated / Local RPC)
BLOCKCHAIN_NETWORK=simulated_ledger
BLOCKCHAIN_RPC_URL=http://localhost:8545
PROVENANCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Model Context Protocol (MCP) Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
MCP_AUTH_TOKEN_PLACEHOLDER=your_mcp_auth_token_here

# Telemetry & Experiment Output
EXPERIMENT_RUNS_DIR=experiments/runs
EXPERIMENT_RESULTS_DIR=experiments/results
